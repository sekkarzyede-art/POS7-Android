unt.endsWith('_lbp')?'LBP':'USD',fxRate:rate,\n     kind:sale?'return_payment':'return_receipt',r365:true};\n    state.returnVouchers.push(voucher);ret.voucherNumber=voucher.number;\n    const sign=sale?-1:1;\n    state.mcLedger.push({id:Date.now()+Math.random(),account,currency:voucher.currency,amount:sign*g.amountOriginal,amountUSD:sign*g.cash/100,\n     fxRate:rate,exchangeRate:rate,ref:voucher.number,title:(sale?'سند صرف مرتجع مبيعات ':'سند قبض مرتجع مشتريات ')+number,party:inv[partyKey(sale)],date,returnId:id});\n    window.pos7PostJournalEntry({sourceType:voucher.kind,sourceId:voucher.id,reference:voucher.number,date,description:voucher.kind+' '+number,\n     lines:[line(cashCodes[account],sign*g.cash,{currency:voucher.currency,amountOriginal:g.amountOriginal,exchangeRate:rate}),line(sale?'1130':'2110',-sign*g.cash)]});\n   }\n   created.push(ret);\n  }\n  for(const [product,change] of p.stock)product.stock+=change;\n });\n if(!ok)return null;\n try{window.renderAll?.();window.renderHome?.();}catch(e){console.warn(e)}\n return created;\n}\nwindow.POS7R365={active,returns,quantity,price:linePrice,debts,plan,commit,opening,payment,usd,cents,linked};\n})();\n\n</script>\n<style>\n#r364Dialog{width:min(760px,94vw);max-height:88vh;border:1px solid #bfcee0;border-radius:16px;color:#142a47;padding:18px;overflow:auto}\n#r364Dialog::backdrop{background:#0f2139aa}\n#r364Dialog header,#r364Dialog .r364-row{display:flex;align-items:center;justify-content:space-between;gap:12px}\n#r364Dialog label{display:block;margin:10px 0}\n#r364Dialog input:not([type=checkbox]),#r364Dialog select{width:100%;min-height:44px}\n#r364Dialog article{border:1px solid #d5e0ec;border-radius:12px;padding:12px;margin:10px 0}\n#r364Dialog .r364-row{padding:6px 0;border-bottom:1px solid #e3ebf3}\n#r364Dialog .r364-qty{display:flex;align-items:center;gap:10px;margin:8px 0}\n#r364Dialog .r364-qty button{min-width:44px;min-height:44px}\n</style>\n<script id=\"pos7-r365-return-cards\">\n(() => {\n'use strict';\nconst active=x=>x&&!x.cancelled&&!x.canceled&&!x.voided&&!x.reversed&&!/^(cancelled|canceled|voided)$/i.test(x.status||'');\nconst same=(a,b)=>a!=null&&b!=null&&String(a)===String(b);\nconst normal=v=>String(v??'').trim().toLowerCase().replace(/[٠-٩۰-۹]/g,c=>String(c.charCodeAt(0)-(c<='٩'?0x660:0x6f0)));\nconst key=x=>x.productId??x.id;\nconst matches=(a,b)=>key(a)!=null&&key(b)!=null?same(key(a),key(b)):Boolean(normal(a.barcode))&&normal(a.barcode)===normal(b.barcode);\nconst no=x=>x.number||x.no||x.recordNo||x.ref||x.id;\nconst money=c=>'$'+(c/100).toFixed(2);\nconst cents=value=>Math.round(Number(value)*100);\nfunction node(parent,tag,text=''){\n const e=document.createElement(tag);e.textContent=text;parent.append(e);return e;\n}\nfunction button(parent,label,action){\n const b=node(parent,'button',label);b.type='button';b.className='soft';b.onclick=action;return b;\n}\nfunction option(select,value,label){node(select,'option',label).value=value;}\nfunction row(parent,label,value){\n const div=node(parent,'div');div.className='r364-row';node(div,'span',label);node(div,'b',value).dir='auto';\n}\nfunction sourcePrice(sale,invoice,line){\n try{return window.POS7R365.price(sale,invoice,line)}catch(e){return NaN}\n}\nwindow.pos7R364OpenReturns=function(sale,invoiceId){\n if(!window.v250Can?.(sale?'sales':'purchase'))return toast('لا توجد صلاحية لهذه البطاقة.');\n const partyKey=sale?'customer':'supplier';\n const docs=(sale?state.sales:state.purchases)||[];\n const returns=(sale?state.salesReturns:[...(state.purchaseReturns||[]),...(state.purchasesReturns||[]),...(state.supplierReturns||[])])||[];\n const original=invoiceId==null?null:docs.find(x=>active(x)&&same(x.id,invoiceId));\n if(invoiceId!=null&&!original)return toast('الفاتورة الأصلية غير متاحة.');\n document.getElementById('r364Dialog')?.remove();\n const dialog=node(document.body,'dialog');dialog.id='r364Dialog';dialog.dir='rtl';\n const heading=node(dialog,'header');\n node(heading,'h2',sale?'مرتجع مبيعات':'مرتجع مشتريات');\n button(heading,'إغلاق',()=>dialog.close());\n dialog.onclose=()=>dialog.remove();\n\n const party=node(node(dialog,'label',sale?'العميل':'المورد'),'select');\n option(party,'','اختر '+(sale?'العميل':'المورد'));\n for(const name of [...new Set(docs.filter(active).map(x=>x[partyKey]).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'ar')))option(party,name,name);\n if(original)party.value=original[partyKey];\n const form=node(dialog,'form'),query=node(node(form,'label','اسم الصنف أو الباركود'),'input');\n query.autocomplete='off';query.placeholder='اكتب اسم الصنف أو امسح الباركود';\n node(form,'button','بحث');\n const status=node(dialog,'p');status.setAttribute('role','status');\n const results=node(dialog,'div'),basket=node(dialog,'div'),preview=node(dialog,'div'),history=node(dialog,'div');\n const account=node(node(dialog,'label','الصندوق'),'select');\n for(const [key,label] of [['cashier_usd','الكاشير USD'],['main_usd','الصندوق الكبير USD'],['cashier_lbp','الكاشير LBP'],['main_lbp','الصندوق الكبير LBP']])option(account,key,label);\n account.value=sale?'cashier_usd':'main_usd';\n const rate=node(node(dialog,'label','سعر صرف الليرة لكل دولار'),'input');rate.type='number';rate.min='1';rate.value=Number(state.fxRate)||90000;\n account.onchange=()=>render();rate.oninput=()=>render();\n let cart=[],settings=new Map();\n const token=crypto.randomUUID();\n\n function invoiceLines(){\n  return docs.filter(x=>active(x)&&x[partyKey]===party.value)\n   .sort((a,b)=>Date.parse(b.date)-Date.parse(a.date))\n   .flatMap(invoice=>(invoice.items||[]).map((line,index)=>({invoice,line,index,price:sourcePrice(sale,invoice,line)})))\n   .filter(source=>Number.isFinite(source.price));\n }\n function remaining(source,except){\n  const inv=docs.find(x=>same(x.id,source.invoice.id));\n  if(!inv||!active(inv))return 0;\n  const reserved=cart.filter(z=>z!==except&&same(z.invoice.id,inv.id)&&z.index===source.index).reduce((sum,z)=>sum+z.qty,0);\n  return Math.max(0,window.POS7R365.quantity(sale,inv,source.index)-reserved);\n }\n function add(source){\n  if(remaining(source)<=0)return;\n  const current=cart.find(x=>x.invoice===source.invoice&&x.index===source.index&&!x.damaged);\n  if(current)current.qty++;else cart.push({...source,qty:1,damaged:false});\n  results.replaceChildren();query.value='';status.textContent='';render();\n }\n function sourceOptions(source){\n  return invoiceLines().filter(z=>matches(z.line,source.line)&&remaining(z,source)>0);\n }\n form.onsubmit=event=>{\n  event.preventDefault();results.replaceChildren();\n  if(!party.value){status.textContent='اختر الطرف أولًا.';return;}\n  const term=normal(query.value);\n  if(!term){status.textContent='أدخل اسم الصنف أو الباركود.';return;}\n  const found=[];\n  for(const source of invoiceLines()){\n   const {line}=source;\n   if((normal(line.barcode)===term||normal(line.name??line.product).includes(term))&&\n    remaining(source)>0&&!found.some(z=>matches(z.line,line)))found.push(source);\n  }\n  if(found.length===1){add(found[0]);return;}\n  status.textContent=found.length?'اختر الصنف.':'لا توجد كمية مؤهلة مطابقة لهذا الطرف.';\n  for(const source of found.slice(0,30))button(results,(source.line.name??source.line.product??'')+' · '+(source.line.barcode??''),()=>add(source));\n };\n party.onchange=()=>{cart=[];settings.clear();results.replaceChildren();status.textContent='';render();};\n function render(){\n  basket.replaceChildren();preview.replaceChildren();\n  for(const item of cart){\n   const card=node(basket,'article');\n   node(card,'strong',item.line.name??item.line.product??item.line.barcode);\n   const select=node(node(card,'label','الفاتورة الأصلية'),'select');\n   const sources=sourceOptions(item);\n   for(const [i,source] of sources.entries()){\n    const date=source.invoice.date?new Date(source.invoice.date).toLocaleDateString('ar-LB'):'';\n    option(select,i,[no(source.invoice),date,money(cents(source.price))].join(' · '));\n    if(source.invoice===item.invoice&&source.index===item.index)select.value=i;\n   }\n   select.onchange=()=>{const next=sources[Number(select.value)];Object.assign(item,next,{qty:Math.min(item.qty,remaining(next,item))});render();};\n   row(card,'المتاح للإرجاع',remaining(item,item));row(card,'قيمة السطر',money(cents(item.qty*item.price)));\n   const controls=node(card,'div');controls.className='r364-qty';\n   button(controls,'−',()=>{item.qty--;render();}).disabled=item.qty<=1;\n   node(controls,'b',item.qty);\n   button(controls,'+',()=>{item.qty++;render();}).disabled=item.qty>=remaining(item,item);\n   button(controls,'إزالة',()=>{cart=cart.filter(z=>z!==item);render();});\n   if(sale){\n    const label=node(card,'label','تالف  '),check=node(label,'input');check.type='checkbox';check.checked=item.damaged;\n    check.onchange=()=>{item.damaged=check.checked;render();};\n   }\n  }\n  if(!cart.length)return;\n  node(preview,'h3','تسوية المرتجع');\n  let plan;\n  try{plan=window.POS7R365.plan(sale,cart,settings,account.value,Number(rate.value));}\n  catch(error){node(preview,'p',error.message);return;}\n  row(preview,'إجمالي المرتجع',money(plan.groups.reduce((n,g)=>n+g.total,0)));\n  for(const g of plan.groups){\n   const card=node(preview,'article');node(card,'b',no(g.invoice));\n   row(card,'تخفيض الدين',money(g.debt));\n   if(g.total>g.debt){\n    const select=node(node(card,'label','تسوية المتبقي'),'select');\n    option(select,'credit',sale?'رصيد لصالح العميل':'مبلغ مستحق لنا لدى المورد');\n    option(select,'cash',sale?'رد النقد فعليًا':'قبض النقد فعليًا');\n    select.value=settings.get(g.invoice.id)||'credit';\n    select.onchange=()=>{settings.set(g.invoice.id,select.value);render();};\n   }\n   row(card,'حركة الصندوق',String(g.amountOriginal)+' '+(account.value.endsWith('_lbp')?'LBP':'USD'));\n   row(card,sale?'رصيد لصالح العميل':'مستحق لنا لدى المورد',money(g.credit));\n  }\n  for(const [product,change] of plan.stock)row(preview,product.name+' · المخزون',product.stock+' ← '+(product.stock+change));\n  const save=button(preview,'اعتماد المرتجع',()=>{\n   if(!confirm('اعتماد المرتجع بقيمة '+money(plan.groups.reduce((n,g)=>n+g.total,0))+'؟'))return;\n   save.disabled=true;\n   try{\n    const result=window.POS7R365.commit(sale,cart,settings,account.value,Number(rate.value),token);\n    if(!result){save.disabled=false;return;}\n    cart=[];settings.clear();results.replaceChildren();form.hidden=true;party.disabled=true;account.disabled=true;rate.disabled=true;\n    for(const ret of result){\n     row(history,ret.number+' · '+ret.invoiceNumber,money(cents(ret.totalUSD)));\n     if(ret.voucherNumber)row(history,ret.voucherNumber,money(cents(ret.cashRefund)));\n    }\n    status.textContent='تم حفظ المرتجع وتحديث المخزون والحساب.';render();\n   }catch(error){status.textContent=error.message;save.disabled=false;}\n  });\n }\n\n if(original){\n  const eligible=invoiceLines().filter(x=>x.invoice===original&&remaining(x)>0);\n  for(const source of eligible)button(results,source.line.name??source.line.barcode,()=>add(source));\n }\n dialog.showModal();\n};\n})();\n</script>\n\n<script id=\"pos7-r365-returns-integration\">\n(function(){\n'use strict';\nconst E=window.POS7R365;\nconst fmt=v=>'$'+Number(v).toFixed(2);\nconst esc=v=>String(v??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst has=(sale,name)=>E.returns(sale).some(r=>r.r365&&r[sale?'customer':'supplier']===name);\nfunction supplierBalance(name,before){\n const cutoff=before?new Date(before).getTime():Infinity;\n let value=E.opening(false,name);\n for(const inv of state.purchases||[])if(E.active(inv)&&inv.supplier===name&&Date.parse(inv.date)<cutoff)value+=E.cents(window.pos265InvoiceDebtUSD(inv));\n for(const p of state.supplierPayments||[])if(E.active(p)&&p.supplier===name&&Date.parse(p.date)<cutoff)value-=E.payment(p);\n for(const r of E.returns(false))if(r.r365&&r.supplier===name&&Date.parse(r.date)<cutoff)value-=E.cents(r.totalUSD-r.cashRefund);\n return value/100;\n}\nfor(const name of ['pos167SupplierBalanceUSD','pos226SupplierBalanceUSD','pos265SupplierBalanceUSD','pos322SupplierBalanceUSD','pos360SupplierBalanceUSD']){\n const prior=window[name];\n window[name]=function(p,before){return has(false,p)?supplierBalance(p,before):prior?.(p,before)||0};\n}\nconst priorBalance=window.pos387BalanceUSD;\nwindow.pos387BalanceUSD=function(kind,name){return kind==='supplier'&&has(false,name)?supplierBalance(name):priorBalance(kind,name)};\nconst priorRender=window.renderSupplierStatement;\nfunction renderSupplier(){\n let name=typeof selectedSupplier==='undefined'?'':selectedSupplier;\n if(!has(false,name))return priorRender?.apply(this,arguments);\n const box=document.getElementById('supplierStatement');if(!box)return;\n const fromValue=document.getElementById('supplierFrom')?.value,toValue=document.getElementById('supplierTo')?.value;\n const from=fromValue?Date.parse(fromValue+'T00:00:00'):0,to=toValue?Date.parse(toValue+'T23:59:59.999'):Date.now();\n if(from>to){box.textContent='تاريخ البداية يجب أن يسبق النهاية';return;}\n const rows=[],add=(date,ref,title,delta,id)=>rows.push({date,ref,title,delta,id,time:Date.parse(date)});\n for(const inv of state.purchases||[]){\n  if(!E.active(inv)||inv.supplier!==name)continue;\n  const total=inv.totalUSD??E.usd(inv,inv.total),debt=window.pos265InvoiceDebtUSD(inv);\n  add(inv.date,inv.number,'فاتورة شراء',total,inv.id);\n  if(total-debt)add(inv.date,inv.number,'دفعة ضمن فاتورة الشراء',-(total-debt));\n }\n for(const pay of state.supplierPayments||[])if(E.active(pay)&&pay.supplier===name)add(pay.date,pay.ref||pay.id,'سند صرف للمورد',-E.payment(pay)/100);\n for(const ret of E.returns(false))if(ret.r365&&ret.supplier===name)add(ret.date,ret.number+' ← '+ret.invoiceNumber,'مرتجع مشتريات',-ret.totalUSD);\n for(const v of state.returnVouchers||[])if(E.active(v)&&v.kind==='return_receipt'&&v.supplier===name)add(v.date,v.number+' ← '+v.returnNumber,'سند قبض من المورد',v.amountUSD);\n rows.sort((a,b)=>a.time-b.time);\n let balance=E.opening(false,name)/100;\n for(const r of rows)if(r.time<from)balance+=r.delta;\n let body='<tr><td></td><td>رصيد أول المدة</td><td></td><td></td><td></td><td>'+fmt(balance)+'</td></tr>';\n for(const r of rows.filter(x=>x.time>=from&&x.time<=to)){\n  balance+=r.delta;\n  body+='<tr><td>'+esc(new Date(r.date).toLocaleString('ar-LB'))+'</td><td>'+esc(r.title)+'</td><td>'+esc(r.ref)+'</td><td>'+(r.delta>0?fmt(r.delta):'—')+'</td><td>'+(r.delta<0?fmt(-r.delta):'—')+'</td><td>'+fmt(balance)+'</td></tr>';\n }\n body+='<tr><td></td><td>رصيد آخر المدة</td><td></td><td></td><td></td><td>'+fmt(balance)+'</td></tr>';\n box.innerHTML='<div class=\"statement-wrap\"><table class=\"statement-table\"><thead><tr><th>التاريخ</th><th>الحركة</th><th>المرجع</th><th>زيادة المستحق</th><th>تخفيض المستحق</th><th>الرصيد</th></tr></thead><tbody>'+body+'</tbody></table></div>';\n const e=document.getElementById('supplierDetailsBalance');if(e)e.textContent=fmt(supplierBalance(name));\n}\nwindow.pos232RenderSupplierStatement=window.renderSupplierStatement=renderSupplier;\nconst open=window.openSupplierDetails;\nwindow.openSupplierDetails=function(name){const r=open.apply(this,arguments);if(has(false,name))setTimeout(()=>{renderSupplier();const e=document.getElementById('supplierDetailsBalance');if(e)e.textContent=fmt(supplierBalance(name));},100);return r};\nconst renderList=window.renderSuppliers;\nwindow.renderSuppliers=function(){\n const result=renderList?.apply(this,arguments);\n for(const row of document.querySelectorAll('#suppliersList .line')){\n  const name=row.querySelector('b')?.textContent;\n  if(has(false,name)){const label=row.querySelector('small');if(label)label.textContent='الرصيد الحالي '+fmt(supplierBalance(name));}\n }\n return result;\n};\nwindow.pos306ReturnInvoice=(sale,id)=>window.pos7R364OpenReturns(sale,id);\nfunction protect(sale,id){\n return E.returns(sale).some(r=>r.r365&&(String(r.invoiceId)===String(id)));\n}\nfor(const [name,sale] of [['editSale',true],['pos101EditInvoiceFromReport',true],['editPurchase',false],['pos106EditPurchaseFromReport',false]]){\n const prior=window[name];if(typeof prior!=='function')continue;\n window[name]=function(id){if(protect(sale,id))return toast('الفاتورة مرتبطة بمرتجع محفوظ');return prior.apply(this,arguments)};\n}\nfor(const api of [window.POS7R359Accounting,window.POS7R357Journal]){\n if(!api)continue;\n const method=api.plan?'plan':'adjustment',base=api[method];\n api[method]=function(kind,inv,operation){\n  if((method==='adjustment'||operation==='edit'||operation==='cancel')&&protect(kind==='sale',inv.id))throw Error('الفاتورة مرتبطة بمرتجع محفوظ');\n  return base.apply(this,arguments);\n };\n}\nconst cancel=window.pos306CancelInvoice;\nwindow.pos306CancelInvoice=function(sale,id){if(protect(sale,id))return toast('الفاتورة مرتبطة بمرتجع محفوظ');return cancel?.apply(this,arguments)};\n})();\n\n</script>"]]}
